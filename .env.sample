#Insforge
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Optional — default 90000 (90s). Raise if resume uploads time out on slow networks.
NEXT_PUBLIC_INSFORGE_TIMEOUT_MS=90000

# Optional — per-attempt budget for profile load (default 45000). Retries on 504/timeout.
# NEXT_PUBLIC_PROFILE_FETCH_TIMEOUT_MS=45000

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# OpenRouter (server-only — never NEXT_PUBLIC_)
# Single key (still supported):
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
#
# Multiple keys for rate-limit failover (preferred). Comma, semicolon, or newline separated:
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free

# App environment: development|dev (no 429 enforcement) | production|prod (429 on shared Resume AI pool)
APP_ENV=development

# Redis — required when APP_ENV=production|prod for Resume AI rate limits + usage bar.
# Also enables usage tracking in development when set (hits recorded; 429 only in production).
# REDIS_URL=redis://default:password@host:6379
REDIS_URL=

# Shared Extract + Generate rate limits (server-only). Defaults: 3 / min, 15 / hour, 40 / day.
RESUME_AI_RATE_LIMIT_PER_MINUTE=3
RESUME_AI_RATE_LIMIT_PER_HOUR=15
RESUME_AI_RATE_LIMIT_PER_DAY=40

# BYOK — AES-256-GCM encryption for user OpenRouter keys on /profile (server-only).
# Required when users save personal keys. Generate a long random secret (e.g. openssl rand -hex 32).
BYOK_ENCRYPTION_SECRET=
