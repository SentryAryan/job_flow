#Insforge
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Optional — default 90000 (90s). Raise if resume uploads time out on slow networks.
NEXT_PUBLIC_INSFORGE_TIMEOUT_MS=90000

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# OpenRouter (server-only — never NEXT_PUBLIC_)
# Single key (still supported):
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
#
# Multiple keys for rate-limit failover (preferred). Comma, semicolon, or newline separated:
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
