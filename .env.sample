#Insforge
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Optional — default 90000 (90s). Raise if resume uploads time out on slow networks.
NEXT_PUBLIC_INSFORGE_TIMEOUT_MS=90000
# Optional — server API routes (requireAuth / jobs / agent). Defaults to 60000, or NEXT_PUBLIC_INSFORGE_TIMEOUT_MS if set.
# INSFORGE_SERVER_TIMEOUT_MS=60000

# Optional — per-attempt budget for profile load (default 45000). Retries on 504/timeout.
# NEXT_PUBLIC_PROFILE_FETCH_TIMEOUT_MS=45000

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-only — Query API for dashboard charts (Feature 17). Without these,
# /api/dashboard/charts returns empty zero-filled series (HTTP 200).
# Create a personal API key in PostHog → Settings → Personal API keys (query scope).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# OpenRouter (server-only — never NEXT_PUBLIC_)
# Single key (still supported):
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Multiple keys for rate-limit failover (preferred). Comma, semicolon, or newline separated:
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free

# App environment: development|dev (no 429 on per-user OR per-IP Resume AI pools)
# | production|prod (429 on both pools when Redis + client IP are available)
APP_ENV=development

# Redis — required when APP_ENV=production|prod for shared AI rate limits + usage bar
# (Extract + Generate + Find Jobs + Company Research). Also enables usage tracking in
# development when set (hits recorded; 429 only in production).
# REDIS_URL=redis://default:password@host:6379
REDIS_URL=

# Shared Extract + Generate + Find Jobs + Company Research rate limits (server-only).
# Defaults: 3 / min, 15 / hour, 40 / day. Skipped when the user has BYOK OpenRouter keys.
# 429 only when APP_ENV=production|prod. Research: +1 per successful LLM call.
RESUME_AI_RATE_LIMIT_PER_MINUTE=10
RESUME_AI_RATE_LIMIT_PER_HOUR=15
RESUME_AI_RATE_LIMIT_PER_DAY=40

# Per-IP abuse backstop for Extract + Generate + Find Jobs + Company Research (server-only).
# Always applies when REDIS_URL is set (including BYOK users). 429 only in production.
# Defaults: 10 / min, 45 / hour, 120 / day. Keys are hashed — raw IPs are never stored.
# Research: 1 hit per Research Company request.
RESUME_AI_IP_RATE_LIMIT_PER_MINUTE=10
RESUME_AI_IP_RATE_LIMIT_PER_HOUR=45
RESUME_AI_IP_RATE_LIMIT_PER_DAY=120

# BYOK — AES-256-GCM encryption for user OpenRouter keys on /profile (server-only).
# Required when users save personal keys. Generate a long random secret (e.g. openssl rand -hex 32).
BYOK_ENCRYPTION_SECRET=

# Adzuna job search (server-only). Required for Find Jobs discovery.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Browserbase (server-only). Required for Company Research (Feature 13).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Company Research timeouts ---
# RESEARCH_TIMEOUT_CLAMP / NEXT_PUBLIC_RESEARCH_TIMEOUT_CLAMP:
#   unset | clamp | hobby  → cap under Vercel Hobby maxDuration 300s (safe default)
#   no_clamp | off | none  → use configured budgets (self-host / Pro; NOT for Vercel Hobby builds)
#
# Suggested presets:
#   Vercel Hobby:     CLAMP=clamp (or omit), OVERALL=270000, EXTRACT=60000, CLIENT=285000, BB=285
#   Vercel Pro:       CLAMP=no_clamp, ROUTE_MAX=800, OVERALL=720000, EXTRACT=180000, CLIENT=750000, BB=780
#   Render/Railway/Fly (always-on Node): same as Pro / no_clamp; watch proxy idle timeouts
#   Local next dev:   no_clamp + values below
#
# Keep EXTRACT so that: EXTRACT <= (OVERALL - GOTO - 90000) / 2
# RESEARCH_TIMEOUT_CLAMP=clamp
# NEXT_PUBLIC_RESEARCH_TIMEOUT_CLAMP=clamp
# RESEARCH_ROUTE_MAX_DURATION_SEC=800
# BROWSERBASE_SESSION_TIMEOUT_SEC=285
# RESEARCH_OVERALL_TIMEOUT_MS=270000
# RESEARCH_GOTO_TIMEOUT_MS=45000
# RESEARCH_EXTRACT_TIMEOUT_MS=60000
# NEXT_PUBLIC_RESEARCH_CLIENT_TIMEOUT_MS=285000
# Optional log level for Pino (default info): LOG_LEVEL=info
